<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cần cấp quyền truy cập thông báo để app hoạt động.\n\nBấm nút bên dưới, tìm &quot;Next Bài&quot; trong danh sách rồi bật lên, sau đó bấm Back để quay lại app này."
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnGrantPermission"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="CẤP QUYỀN TRUY CẬP THÔNG BÁO"
        android:textSize="16sp" />

</LinearLayout>
