<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Bat buoc tu Android 11 (API 30) tro len: neu khong khai bao,
        app se KHONG the liet ke duoc danh sach cac ung dung khac
        (tinh nang "chon 1 ung dung de tu mo sau khi next+back").
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SeekBack.Transparent">

        <!--
            Chi 1 activity duy nhat.
            - Lan dau mo app (chua cap quyen): hien man hinh xin quyen.
            - Cac lan sau (da cap quyen): tu dong chay next -> cho 2s ->
              lui bai, khong hien giao dien gi, roi tu dong dong lai.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            NotificationListenerService la bat buoc de app co the
            "nhin thay" va dieu khien phien nhac (MediaSession) dang phat
            o cac app khac nhu Spotify, YouTube Music, Zing MP3, v.v.
        -->
        <service
            android:name=".NotifListenerService"
            android:label="Next Bai Media Listener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            Receiver chay ngam: goi bang broadcast tu app gan phim tat
            (Button Mapper, Tasker, MacroDroid...) de thuc hien next/lui
            bai MA KHONG mo bat ky Activity/man hinh nao, khong lam gian
            doan ung dung ban dang xem.
        -->
        <receiver
            android:name=".NextBackReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.seekback.ACTION_NEXT_BACK" />
            </intent-filter>
        </receiver>

        <!--
            Accessibility Service: bat phim vat ly (phim so "1") O CAP
            HE THONG, du dang mo bat ky app nao. Nguoi dung phai tu bat
            dich vu nay 1 lan trong Cai dat -> Tro nang (Accessibility).
        -->
        <service
            android:name=".KeyOneAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice.description"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
