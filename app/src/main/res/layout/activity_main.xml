<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cần cấp quyền truy cập thông báo để app hoạt động.\n\nBấm nút bên dưới, tìm &quot;Next Bài&quot; trong danh sách rồi bật lên, sau đó bấm Back để quay lại app này."
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnGrantPermission"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="CẤP QUYỀN TRUY CẬP THÔNG BÁO"
        android:textSize="16sp"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tùy chọn: mở 1 ứng dụng sau khi chuyển bài xong (delay thêm 1 giây)"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvSelectedApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chưa chọn ứng dụng nào"
        android:textStyle="italic"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnChooseApp"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="CHỌN ỨNG DỤNG"
        android:textSize="14sp" />

</LinearLayout>
